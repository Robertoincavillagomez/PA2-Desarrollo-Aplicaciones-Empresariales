<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- ========================= -->
	<!-- SPRING BOOT               -->
	<!-- ========================= -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<!-- ========================= -->
	<!-- DATOS DEL PROYECTO        -->
	<!-- ========================= -->
	<groupId>com.isil.edu.pe</groupId>
	<artifactId>sistema-pedidos-springboot</artifactId>
	<version>2.0.0-SNAPSHOT</version>

	<name>sistema-pedidos-springboot</name>

	<description>
		Migración académica del Sistema de Pedidos
		de Jakarta EE a Spring Boot
	</description>

	<!--
        Se conserva WAR porque las vistas actuales
        siguen siendo JSP.
    -->
	<packaging>war</packaging>

	<!-- ========================= -->
	<!-- CONFIGURACIÓN GENERAL     -->
	<!-- ========================= -->
	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>
	<dependencies>
		<!-- ===================================== -->
		<!-- 1. CAPA WEB                           -->
		<!-- Jakarta Servlet -> Spring MVC         -->
		<!-- ===================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- ===================================== -->
		<!-- 2. INTEGRACIÓN HTTP                   -->
		<!-- Jakarta REST Client -> RestClient     -->
		<!-- ===================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>

		<!-- ===================================== -->
		<!-- 3. PERSISTENCIA                       -->
		<!-- EntityManager -> Spring Data JPA      -->
		<!-- ===================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- ===================================== -->
		<!-- 4. BASE DE DATOS                      -->
		<!-- Histórico local del Sistema Pedidos   -->
		<!-- ===================================== -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ===================================== -->
		<!-- 5. H2 CONSOLE                         -->
		<!-- Solo desarrollo / demostración        -->
		<!-- ===================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
		</dependency>

		<!-- ===================================== -->
		<!-- 6. JSP                                -->
		<!-- Se conservan vistas existentes        -->
		<!-- ===================================== -->
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-jasper</artifactId>
		</dependency>

		<!-- ===================================== -->
		<!-- 7. JSTL / JAKARTA TAGS                -->
		<!-- ===================================== -->
		<dependency>
			<groupId>jakarta.servlet.jsp.jstl</groupId>
			<artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
		</dependency>

		<dependency>
			<groupId>org.glassfish.web</groupId>
			<artifactId>jakarta.servlet.jsp.jstl</artifactId>
		</dependency>

		<!-- ===================================== -->
		<!-- 8. PRUEBAS                            -->
		<!-- JUnit + Mockito + Spring Test         -->
		<!-- ===================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>
				spring-boot-starter-test
			</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<finalName>sistema-pedidos-springboot</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<configuration>
					<!--
                        Codificación general utilizada para
                        los recursos procesados por Maven.
                    -->
					<encoding>${project.build.sourceEncoding}</encoding>
					<!--
                        Codificación utilizada específicamente
                        para archivos .properties.
                    -->
					<propertiesEncoding>${project.build.sourceEncoding}</propertiesEncoding>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>